pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('exercise-09-jenkins-pipeline') {
                    echo 'Checking Python and installed dependencies...'
                    sh '''
                    python3 --version
                    python3 -c "import flask; print('Flask', flask.__version__)"
                    '''
                }
            }
        }
        stage('Test') {
            steps {
                dir('exercise-09-jenkins-pipeline') {
                    echo 'Running tests...'
                    sh 'python3 -m unittest discover -s .'
                }
            }
        }
        stage('Deploy') {
            steps {
                dir('exercise-09-jenkins-pipeline') {
                    echo 'Deploying application...'
                    sh '''
                    mkdir -p python-app-deploy
                    cp app.py python-app-deploy/
                    '''
                }
            }
        }
        stage('Run Application') {
            steps {
                dir('exercise-09-jenkins-pipeline') {
                    echo 'Running application...'
                    sh '''
                    nohup python3 python-app-deploy/app.py > python-app-deploy/app.log 2>&1 &
                    echo $! > python-app-deploy/app.pid
                    '''
                }
            }
        }
        stage('Test Application') {
            steps {
                dir('exercise-09-jenkins-pipeline') {
                    echo 'Testing application...'
                    sh 'python3 test_app.py'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
